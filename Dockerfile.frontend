# Dockerfile.frontend — Multi-stage build for the React frontend
# ───────────────────────────────────────────────────────────────
# Stage 1: Build the Vite app
# Stage 2: Serve with Nginx (alpine — minimal image)

# ── Stage 1: Build ────────────────────────────────────────────────────────
FROM node:20-alpine AS build

WORKDIR /app

# Copy package files first to cache the npm install layer
COPY package.json package-lock.json ./
RUN npm ci --silent

# Copy source and build
COPY index.html vite.config.js ./
COPY src/ ./src/
COPY public/ ./public/

# Set environment for production build
ENV VITE_API_URL=http://localhost/api
ENV VITE_WS_URL=ws://localhost/ws/ticks

RUN npm run build

# ── Stage 2: Serve ────────────────────────────────────────────────────────
FROM nginx:alpine AS serve

# Copy Nginx config
COPY nginx.conf /etc/nginx/nginx.conf

# Copy Vite build output to Nginx static root
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
