# .env.example — CryptoPulse Backend Configuration
# Copy to .env and fill in your values.
# All values have sane defaults for local development.

# ── CoinGecko API ──────────────────────────────────────────────────────────
# Leave empty to use the free tier (30 req/min).
# Get a Pro key at https://www.coingecko.com/en/api/pricing for higher limits.
COINGECKO_API_KEY=

# ── Coin Tracking ───────────────────────────────────────────────────────────
# JSON array of CoinGecko coin IDs to track. Adjust the list as needed.
# Free tier: keep to ≤ 10 coins to stay within rate limits.
COINS_TO_TRACK=["bitcoin","ethereum","binancecoin","solana","cardano","ripple","polkadot","dogecoin"]

# Polling interval in seconds. 10s is safe for the free tier with 8 coins.
POLL_INTERVAL_SECONDS=10

# ── Anomaly Detection Model ─────────────────────────────────────────────────
# "halftrees" = HalfSpaceTrees (adaptive online learning, recommended)
# "zscore"    = Rolling Z-Score (simpler, more explainable)
MODEL_TYPE=halftrees

# Anomaly threshold for HalfSpaceTrees (score ∈ [0, 1]).
# Score > threshold → flagged as anomaly. Lower = more sensitive.
DEFAULT_THRESHOLD_HALFTREES=0.75

# Anomaly threshold for Rolling Z-Score (units: standard deviations).
# |z| > threshold → flagged as anomaly. Lower = more sensitive.
DEFAULT_THRESHOLD_ZSCORE=3.0

# ── Database ────────────────────────────────────────────────────────────────
# Path to the SQLite database file (relative to the backend/ directory).
DATABASE_URL=./cryptopulse.db

# ── Server ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# CORS origins allowed to connect (JSON array).
# In production, replace with your actual frontend URL.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80"]
